{
  "name": "frontend-vite",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test && bunx bats tests/",
    "deploy": "bun run build && bunx wrangler deploy",
    "lint": "bun run type:check && bun run prettier:check && bun run lint:code",
    "lint:fix": "bun run prettier:fix && bun run lint:code --fix",
    "type:check": "tsc --noEmit",
    "lint:code": "eslint \"./**/*.{js,ts}\" --quiet",
    "prettier:check": "prettier --check \"**/*.{ts,js}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,js}\"",
    "pretest": "bun run lint",
    "test:cov": "bun test --coverage && bunx bats tests/",
    "precommit": "bun run lint:fix && bun run test:cov"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260528.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "ts-morph": "^28.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.1",
    "wrangler": "^4.95.0"
  },
  "type": "module",
  "dependencies": {
    "bson": "^7.2.0",
    "solid-js": "^1.9.13",
    "vite-plugin-solid": "^2.11.12"
  }
}
